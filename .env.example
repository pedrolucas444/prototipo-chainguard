# Copie para .env e preencha o que tiver. Tudo é opcional: sem chaves, o sistema
# usa endpoints públicos e o Job de sincronização no lugar do webhook do Alchemy.
NODE_ENV=
PORT=3000
HOST=127.0.0.1
DB_PATH=data/chainguard.db
# Segredo usado para cifrar o segredo TOTP no banco. Gere com: openssl rand -hex 32
APP_SECRET=
# Conta de administrador criada na primeira execução (senha aleatória se vazio; é impressa no console).
ADMIN_EMAIL=admin@chainguard.local
ADMIN_PASSWORD=
# true quando servido via HTTPS (padrão: true se NODE_ENV=production)
COOKIE_SECURE=
# Atrás de proxy reverso (Render, Railway, Fly, Nginx): número de proxies na frente do app (normalmente 1).
# Sem isso, o limitador de requisições vê todos os usuários com o IP do proxy.
TRUST_PROXY=0
# Análises de risco em paralelo na fila (meta: classificar em até 60 s).
QUEUE_CONCURRENCY=4

# Alchemy (monitoramento por webhook "Address Activity")
ALCHEMY_API_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_SIGNING_KEY=
# RPC alternativo (padrão: Alchemy se houver chave, senão PublicNode)
ETH_RPC_URL=

# Reputação
GOPLUS_ACCESS_TOKEN=
ETHERSCAN_API_KEY=
BLOCKSCOUT_URL=https://eth.blockscout.com

# Front-end: WalletConnect (opcional; MetaMask funciona sem isso)
WALLETCONNECT_PROJECT_ID=

# Jobs (intervalos em ms). JOBS=off desliga todos.
JOBS=on
QUOTES_INTERVAL_MS=30000
LISTS_INTERVAL_MS=21600000
FALLBACK_SYNC_MS=60000
